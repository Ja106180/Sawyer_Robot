<?xml version="1.0"?>
<package format="2">
  <name>openclaw_sawyer</name>
  <version>0.0.1</version>
  <description>The openclaw_sawyer package for integrating Sawyer with OpenClaw framework</description>
  <maintainer email="user@todo.todo">Antigravity</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <build_depend>rospy</build_depend>
  <build_depend>std_msgs</build_depend>
  <build_depend>std_srvs</build_depend>
  <build_depend>sensor_msgs</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>intera_interface</build_depend>

  <exec_depend>rospy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>intera_interface</exec_depend>
  <exec_depend>rosbridge_suite</exec_depend>
  <exec_depend>web_video_server</exec_depend>

  <export>
  </export>
</package>
